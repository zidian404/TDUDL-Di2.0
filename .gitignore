# 创建 .gitignore 文件
cat > .gitignore << 'EOF'
# Python缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
ENV/
.venv

# IDE配置
.idea/
.vscode/
*.swp
*.swo

# 模型文件（只保留代码，不保留训练好的模型）
model_save/*.pth
model_save/*.pt
!model_save/.gitkeep

# 日志文件
log/*.log
log/*.png

# 数据集（太大，不提交）
dataset/
*.png
*.jpg
*.jpeg

# 系统文件
.DS_Store
Thumbs.db
